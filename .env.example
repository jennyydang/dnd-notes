VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional: server endpoint for roleplay suggestions (never put a model API
# key here — anything VITE_* ships to the browser). See src/lib/roleplayAssistant.js.
VITE_ROLEPLAY_ASSISTANT_URL=
# Optional: turns on "Sign in with ChatGPT" once OpenAI has approved the app
# and issued a client ID (a public ID, not a secret). Needs the chatgpt-auth
# Edge Function deployed — see README → Roleplay assistant.
VITE_CHATGPT_CLIENT_ID=
